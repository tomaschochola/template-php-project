#!/bin/sh
set -eu

program_name=${0##*/}
script_directory=${0%"${program_name}"}
CDPATH='' cd -P -- "${script_directory:-.}" || exit 1
workspace=${PWD}
project=$(printf '%s' "${workspace}" | cksum)
project=${project%% *}
wiremock_image='docker.io/wiremock/wiremock:3.13.2@sha256:0d4ecb3e4dc8213fd7a4d37d6a78f6e6b553a6d2e15bd51b0999781282ac61b3'
mysql_image='docker.io/library/mysql:9.7.4@sha256:86b390ef642f89a0157d6215dee33ddc928b8b0ecab173117f56f6c40cb24eab'
valkey_image='docker.io/valkey/valkey:9.1.3@sha256:3add1a336a920ea54770a001ab6feb3da5fceea96a40373a3a2cd469b815f0b7'

help() {
    printf 'Usage: %s [command]\n       %s execute program [argument ...]\n\nCommands:\n' "${program_name}" "${program_name}"
    printf '  %-16s  %s\n' \
        'up' 'Start the environment; build and initialize it if new' \
        'down' 'Stop containers; retain data' \
        'integration' 'Run checks in temporary containers using this checkout' \
        'recreate' 'Rebuild and initialize containers; retain data volumes' \
        'shell' 'Open an interactive workspace shell' \
        'execute' 'Execute a command in the workspace' \
        'logs' 'Show recent workspace and service logs' \
        'ports' 'Show published host ports' \
        'purge' 'Delete project containers, data and unused images' \
        'help' 'Show this help'
}

build() {
    podman build --file Containerfile --target workspace --label "io.pdmn.project=${project}" --tag "localhost/${project}-workspace:latest" .
}

start() {
    podman network create --ignore --label "io.pdmn.project=${project}" "${project}-network" > /dev/null
    podman volume create --ignore --label "io.pdmn.project=${project}" "${project}-mysql" > /dev/null
    podman volume create --ignore --label "io.pdmn.project=${project}" "${project}-valkey" > /dev/null
    podman container exists "${project}-mysql" || podman create --name "${project}-mysql" --label "io.pdmn.project=${project}" --network "${project}-network" --network-alias mysql --health-cmd 'mysqladmin ping --host=127.0.0.1 --silent' --health-interval 10s --health-retries 3 --health-start-period 30s --health-timeout 5s --stop-timeout 60 --env MYSQL_DATABASE=db --env MYSQL_USER=db --env MYSQL_PASSWORD_FILE=/run/secrets/db_password --env MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_password --volume "${workspace}/ops/local/mysql_password:/run/secrets/db_password:ro,z" --volume "${workspace}/ops/local/mysql/99_unit.sql:/docker-entrypoint-initdb.d/99_unit.sql:ro,z" --volume "${project}-mysql:/var/lib/mysql" "${mysql_image}"
    podman start "${project}-mysql" > /dev/null
    podman wait --condition healthy --condition unhealthy --condition exited "${project}-mysql" > /dev/null
    podman healthcheck run "${project}-mysql"
    podman container exists "${project}-valkey" || podman create --name "${project}-valkey" --label "io.pdmn.project=${project}" --network "${project}-network" --network-alias valkey --health-cmd 'valkey-cli ping' --health-interval 10s --health-retries 3 --health-start-period 10s --health-timeout 5s --stop-timeout 30 --volume "${project}-valkey:/data" "${valkey_image}"
    podman start "${project}-valkey" > /dev/null
    podman wait --condition healthy --condition unhealthy --condition exited "${project}-valkey" > /dev/null
    podman healthcheck run "${project}-valkey"
    podman container exists "${project}-wiremock" || podman create --name "${project}-wiremock" --label "io.pdmn.project=${project}" --network "${project}-network" --network-alias wiremock --publish 127.0.0.1::8080 --health-cmd 'curl --fail --silent --show-error http://127.0.0.1:8080/__admin/health' --health-interval 10s --health-retries 3 --health-start-period 30s --health-timeout 5s --stop-timeout 30 --volume "${workspace}/ops/local/wiremock/mappings:/home/wiremock/mappings:ro,z" "${wiremock_image}"
    podman start "${project}-wiremock" > /dev/null
    podman wait --condition healthy --condition unhealthy --condition exited "${project}-wiremock" > /dev/null
    podman healthcheck run "${project}-wiremock"
    podman container exists "${project}-workspace" || podman create --name "${project}-workspace" --label "io.pdmn.project=${project}" --network "${project}-network" --network-alias workspace --shm-size 512m --init --interactive --publish 127.0.0.1::8080 --security-opt label=disable --user 1000:1000 --userns keep-id:uid=1000,gid=1000 --env APP_ENV=local --env MYSQL_DATABASE=db --env MYSQL_HOST=mysql --env MYSQL_USER=db --env MYSQL_PASSWORD_FILE=/run/secrets/db_password --env MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_password --volume "${workspace}/ops/local/mysql_password:/run/secrets/db_password:ro,z" --env MYSQL_UNIT_DATABASE=db_unit --env NODE_ENV=development --env WIREMOCK_URL=http://wiremock:8080 --volume "${workspace}:/workspace" --workdir /workspace "localhost/${project}-workspace:latest" sleep infinity
    podman start "${project}-workspace" > /dev/null
}

up() {
    if podman container exists "${project}-workspace"; then
        start
    else
        build
        start
        podman exec --workdir /workspace "${project}-workspace" make postcreate
    fi
}

integration() {
    project="${project}-$$"
    trap purge EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    up
    podman exec --interactive --workdir /workspace "${project}-workspace" make check
}

down() {
    podman stop --all --filter "label=io.pdmn.project=${project}"
}

recreate() {
    down
    podman rm --all --filter "label=io.pdmn.project=${project}"
    up
}

shell() {
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        exit 2
    fi

    exec podman exec -it --workdir /workspace "${project}-workspace" /bin/sh
}

execute() {
    exec podman exec --interactive --workdir /workspace "${project}-workspace" "$@"
}

logs() {
    if [ -t 0 ] && [ -t 1 ]; then
        exec podman logs --follow --names --tail 100 "${project}-workspace" "${project}-mysql" "${project}-valkey" "${project}-wiremock"
    fi

    podman logs --names --tail 100 "${project}-workspace" "${project}-mysql" "${project}-valkey" "${project}-wiremock"
}

ports() {
    printf '%s\n' 'workspace:'
    podman port "${project}-workspace" 8080/tcp
    printf '%s\n' 'wiremock:'
    podman port "${project}-wiremock" 8080/tcp
}

purge() {
    down
    podman rm --all --filter "label=io.pdmn.project=${project}"
    podman network prune --force --filter "label=io.pdmn.project=${project}"
    podman volume prune --force --all --filter "label=io.pdmn.project=${project}"
    podman image prune --force --all --filter "label=io.pdmn.project=${project}"
}

main() {
    case ${1:-help} in
        up)
            up
            ;;

        integration)
            integration
            ;;

        down)
            down
            ;;

        recreate)
            recreate
            ;;

        shell)
            shell
            ;;

        execute)
            shift
            execute "$@"
            ;;

        logs)
            logs
            ;;

        ports)
            ports
            ;;

        purge)
            purge
            ;;

        help)
            help
            ;;

        *)
            help >&2
            exit 2
            ;;
    esac
}

main "$@"
