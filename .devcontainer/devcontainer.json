{
  "containerUser": "devcontainer",
  "customizations": {
    "vscode": {
      "extensions": ["EditorConfig.EditorConfig", "Tyriar.sort-lines", "docker.docker", "ms-azuretools.vscode-containers", "ms-vscode.makefile-tools", "DEVSENSE.phptools-vscode"],
      "settings": {
        "editor.codeActionsOnSave": {
          "source.addMissingImports.ts": "explicit",
          "source.fixAll.ts": "explicit",
          "source.sort.json": "explicit"
        },
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true
      }
    }
  },
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose-devcontainer.yml"],
  "init": true,
  "postCreateCommand": "make postcreate",
  "remoteUser": "devcontainer",
  "service": "devcontainer",
  "workspaceFolder": "/var/www/html"
}
